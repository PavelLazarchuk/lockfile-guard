      "integrity": "sha512-BASEvitest==",
      "dev": true
    },
    "node_modules/from-git": {
      "version": "1.0.0",
      "resolved": "git+ssh://git@github.com/acme/from-git.git#0f9e8d7"
    }
  }
}

{
  "name": "monorepo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo",
      "workspaces": ["packages/*"],
      "devDependencies": { "vitest": "^2.0.0" }
    },
    "packages/api": {
      "name": "@demo/api",
      "version": "1.0.0",
      "dependencies": { "left-pad": "^1.3.0" }

  },
  "findings": [
    {
      "rule": "registry-mismatch",
      "severity": "critical",
      "package": {
        "name": "tiny-helper",
        "version": "2.0.0",
        "path": "node_modules/tiny-helper"
      },
      "evidence": "resolves to https://evil-registry.example.com, not to https://registry.npmjs.org"
    },
    {
      "rule": "integrity-missing",
      "severity": "high",
      "package": {
        "name": "unsigned-thing",
        "version": "1.0.0",
        "path": "node_modules/unsigned-thing"
